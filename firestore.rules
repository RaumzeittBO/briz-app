rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
    }

    function activeAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && profile().active == true
        && profile().role in ['admin', 'manager', 'mechanic', 'viewer'];
    }

    function hasRole(roles) {
      return activeAdmin() && profile().role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function validArtworkVariant(variants, variant) {
      return !(variant in variants)
        || (variants[variant] is map
          && (!('sourceVariant' in variants[variant])
            || variants[variant].sourceVariant in ['esDesktop', 'esMobile', 'enDesktop', 'enMobile']));
    }

    function nextArtworkVariant(variants, variant) {
      return variant in ['esDesktop', 'esMobile', 'enDesktop', 'enMobile']
        && variant in variants
        && variants[variant] is map
        && 'sourceVariant' in variants[variant]
        && variants[variant].sourceVariant in ['esDesktop', 'esMobile', 'enDesktop', 'enMobile']
        ? variants[variant].sourceVariant
        : '';
    }

    function noArtworkCycleFrom(variants, start) {
      let first = nextArtworkVariant(variants, start);
      let second = nextArtworkVariant(variants, first);
      let third = nextArtworkVariant(variants, second);
      let fourth = nextArtworkVariant(variants, third);
      return (first == '' || first != start)
        && (second == '' || (second != start && second != first))
        && (third == '' || (third != start && third != first && third != second))
        && (fourth == '' || (fourth != start && fourth != first && fourth != second && fourth != third));
    }

    function noArtworkVariantCycles(variants) {
      return variants is map
        && validArtworkVariant(variants, 'esDesktop')
        && validArtworkVariant(variants, 'esMobile')
        && validArtworkVariant(variants, 'enDesktop')
        && validArtworkVariant(variants, 'enMobile')
        && noArtworkCycleFrom(variants, 'esDesktop')
        && noArtworkCycleFrom(variants, 'esMobile')
        && noArtworkCycleFrom(variants, 'enDesktop')
        && noArtworkCycleFrom(variants, 'enMobile');
    }

    function artworkFileLockAfter(slotId, variant, variants) {
      return !(variant in variants)
        || !(variants[variant] is map)
        || !('storagePath' in variants[variant])
        || (variants[variant].storagePath is string
          && variants[variant].publicationFileName is string
          && variants[variant].publicationId == slotId + '__' + variant + '__' + variants[variant].publicationFileName
          && variants[variant].storagePath == 'public-assets/artworks/' + slotId + '/' + variant + '/' + variants[variant].publicationFileName
          && existsAfter(/databases/$(database)/documents/publishedArtworkFiles/$(variants[variant].publicationId)));
    }

    function artworkFilesLockedAfter(slotId, variants) {
      return artworkFileLockAfter(slotId, 'esDesktop', variants)
        && artworkFileLockAfter(slotId, 'esMobile', variants)
        && artworkFileLockAfter(slotId, 'enDesktop', variants)
        && artworkFileLockAfter(slotId, 'enMobile', variants);
    }

    function writesNewArtworkVersion(slotId) {
      return request.resource.data.currentVersionId is string
        && request.resource.data.variants is map
        && noArtworkVariantCycles(request.resource.data.variants)
        && artworkFilesLockedAfter(slotId, request.resource.data.variants)
        && !exists(/databases/$(database)/documents/publicArtworkConfig/$(slotId)/versions/$(request.resource.data.currentVersionId))
        && existsAfter(/databases/$(database)/documents/publicArtworkConfig/$(slotId)/versions/$(request.resource.data.currentVersionId))
        && getAfter(/databases/$(database)/documents/publicArtworkConfig/$(slotId)/versions/$(request.resource.data.currentVersionId)).data.variants == request.resource.data.variants;
    }

    function isCommercialManager() {
      return hasRole(['admin', 'manager']);
    }

    function isScopedRead() {
      return activeAdmin()
        && (profile().role == 'admin'
          || profile().store == 'all'
          || (resource.data.store is string && resource.data.store == profile().store));
    }

    function isScopedWrite() {
      return isCommercialManager()
        && (profile().role == 'admin'
          || profile().store == 'all'
          || (request.resource.data.store is string && request.resource.data.store == profile().store));
    }

    function isScopedDelete() {
      return isCommercialManager()
        && (profile().role == 'admin'
          || profile().store == 'all'
          || (resource.data.store is string && resource.data.store == profile().store));
    }

    function isScopedRoleWrite(roles) {
      return hasRole(roles)
        && (profile().role == 'admin'
          || profile().store == 'all'
          || (request.resource.data.store is string && request.resource.data.store == profile().store));
    }

    function isScopedRoleDelete(roles) {
      return hasRole(roles)
        && (profile().role == 'admin'
          || profile().store == 'all'
          || (resource.data.store is string && resource.data.store == profile().store));
    }

    match /adminUsers/{adminUserId} {
      allow get: if activeAdmin() && (isAdmin() || request.auth.uid == adminUserId);
      allow list: if isAdmin();
      // Roles are provisioned only by a trusted Admin SDK function/CLI migration.
      allow create, update, delete: if false;

      // Private idempotency markers for a manager's own manually-created sales.
      match /manualSaleOperations/{operationId} {
        allow get: if activeAdmin() && isCommercialManager() && request.auth.uid == adminUserId;
        allow list: if false;
        allow create: if activeAdmin()
          && isCommercialManager()
          && request.auth.uid == adminUserId
          && request.resource.data.keys().hasOnly(['saleId', 'createdAt'])
          && request.resource.data.saleId == operationId
          && request.resource.data.createdAt is string;
        allow update, delete: if false;
      }
    }

    match /settings/{settingId} {
      allow read: if settingId in ['rental_settings', 'bike_categories', 'shop_categories', 'admin_navigation'] || isAdmin();
      allow write: if isAdmin();
    }

    // Published artwork metadata is the only part of this module public.
    match /publicArtworkConfig/{slotId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && writesNewArtworkVersion(slotId);
      allow delete: if false;

      // Version snapshots are retained for Admin rollback, not exposed to visitors.
      match /versions/{versionId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['id', 'variants', 'actorUid', 'action', 'restoredFrom', 'createdAt'])
          && request.resource.data.id == versionId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.action in ['publish', 'restore', 'share']
          && request.resource.data.variants is map
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    // A marker is created atomically with the first config version that
    // references a Storage object. It is immutable so historical assets can
    // never become deletable after they stop being the active variant.
    match /publishedArtworkFiles/{publicationId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin()
        && !exists(/databases/$(database)/documents/publishedArtworkFiles/$(publicationId))
        && request.resource.data.keys().hasOnly(['id', 'slotId', 'variant', 'storagePath', 'fileName', 'createdAt'])
        && request.resource.data.id == publicationId
        && request.resource.data.slotId is string
        && request.resource.data.variant in ['esDesktop', 'esMobile', 'enDesktop', 'enMobile']
        && request.resource.data.fileName.matches('[A-Za-z0-9_-]+\\.(png|jpg|webp)')
        && publicationId == request.resource.data.slotId + '__' + request.resource.data.variant + '__' + request.resource.data.fileName
        && request.resource.data.storagePath == 'public-assets/artworks/' + request.resource.data.slotId + '/' + request.resource.data.variant + '/' + request.resource.data.fileName
        && request.resource.data.createdAt is timestamp
        && existsAfter(/databases/$(database)/documents/publicArtworkConfig/$(request.resource.data.slotId))
        && getAfter(/databases/$(database)/documents/publicArtworkConfig/$(request.resource.data.slotId)).data.variants[request.resource.data.variant].storagePath == request.resource.data.storagePath
        && getAfter(/databases/$(database)/documents/publicArtworkConfig/$(request.resource.data.slotId)).data.variants[request.resource.data.variant].publicationId == publicationId
        && getAfter(/databases/$(database)/documents/publicArtworkConfig/$(request.resource.data.slotId)).data.variants[request.resource.data.variant].publicationFileName == request.resource.data.fileName;
      allow update, delete: if false;
    }

    // Draft metadata never reaches the public artwork feed.
    match /artworkDrafts/{draftId} {
      allow read, write: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow create, update: if isScopedWrite();
      allow delete: if isScopedDelete();
    }

    match /combos/{comboId} {
      allow read: if true;
      allow create, update: if isScopedWrite();
      allow delete: if isScopedDelete();
    }

    match /routes/{routeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /rentals/{rentalId} {
      allow read: if isScopedRead();
      // All lifecycle and financial writes go through trusted Functions/Admin SDK.
      allow create: if false;
      allow update, delete: if false;
    }

    match /rentalPaymentMovements/{movementId} {
      // Payment records are immutable to clients; trusted callables write them.
      allow read: if isScopedRead();
      allow create, update, delete: if false;
    }

    // Legacy customer documents can contain password hashes and identity scans.
    // Keep them server/admin-only; customer apps use a sanitized profile endpoint.
    match /customers/{customerId} {
      // Legacy records may still contain old password hashes; reads go through a sanitizing callable.
      allow read: if false;
      allow create, update: if isScopedWrite();
      allow delete: if isScopedDelete();
    }

    match /customerProfiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    match /customerPrivate/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pendingCustomerRegistrations/{uid} {
      allow read, write: if false;
    }

    match /rentals_busy_slots/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    match /sales/{saleId} {
      allow read: if isScopedRead();
      allow create, update: if isScopedWrite();
      allow delete: if isScopedDelete();
    }

    match /serviceOrders/{serviceOrderId} {
      allow read: if isScopedRead();
      allow create: if isScopedRoleWrite(['admin', 'manager', 'mechanic']);
      allow update: if isScopedRoleWrite(['admin', 'manager', 'mechanic']);
      allow delete: if isScopedRoleDelete(['admin', 'manager', 'mechanic']);
    }

    match /communityItems/{itemId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['id', 'name', 'message', 'imageUrl', 'createdAt', 'status']);
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
