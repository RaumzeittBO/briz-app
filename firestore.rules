rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Active administrator verification:
    // Checks that the authenticated user is not disabled in adminUsers/{uid}.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active != false
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role in ['admin', 'manager', 'mechanic', 'viewer'];
    }

    match /adminUsers/{adminUserId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == adminUserId);
      // A user cannot create their own authorization record. Existing admins may
      // provision another account; production migration is performed separately.
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if settingId != 'admin_security' || isAdmin();
      // rental_counter is incremented transactionally when creating a reservation
      allow write: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /combos/{comboId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /routes/{routeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rentals/{rentalId} {
      // Private records and trusted reservation creation must go through a
      // server endpoint. Public availability is exposed separately below.
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /rentals_busy_slots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.total is number
                    && request.resource.data.total >= 0;
      allow update, delete: if isAdmin();
    }

    match /serviceOrders/{serviceOrderId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.customer is string;
      allow update, delete: if isAdmin();
    }

    // Cyclists can submit only pending content. Administrators authenticated
    // through Firebase are the only ones who can approve, reject or remove it.
    match /communityItems/{itemId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Default deny for any unknown collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
