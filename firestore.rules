rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Active administrator verification:
    // Checks that the authenticated user is not disabled in adminUsers/{uid}.
    function isAdmin() {
      return signedIn() && (
        !exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active != false
      );
    }

    match /adminUsers/{adminUserId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if settingId != 'admin_security' || isAdmin();
      // rental_counter is incremented transactionally when creating a reservation
      allow write: if isAdmin() || settingId == 'rental_counter';
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /combos/{comboId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /routes/{routeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rentals/{rentalId} {
      allow read: if true;
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.productId is string
                    && request.resource.data.quantity is number
                    && request.resource.data.quantity > 0
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0;
      allow update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if true;
      allow create: if request.resource.data.name is string;
      allow update: if request.resource.data.name is string;
      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.total is number
                    && request.resource.data.total >= 0;
      allow update, delete: if isAdmin();
    }

    match /serviceOrders/{serviceOrderId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.customer is string;
      allow update, delete: if isAdmin();
    }

    // Cyclists can submit only pending content. Administrators authenticated
    // through Firebase are the only ones who can approve, reject or remove it.
    match /communityItems/{itemId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Default deny for any unknown collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
