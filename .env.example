# Local development must use only Firebase Emulator Suite.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_ENVIRONMENT=emulator

# Required only when using a dedicated non-production Firebase project.
# Leave unset for emulator-only local development.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
