rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.active != false
        && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.role in ['admin', 'manager', 'mechanic', 'viewer'];
    }

    function isValidUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }

    match /customers/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /rentals/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidUpload();
    }

    match /{allPaths=**} {
      allow read: if !allPaths.matches('customers/.*') && !allPaths.matches('rentals/.*');
      allow write: if isAdmin() && isValidUpload();
    }
  }
}
