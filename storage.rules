rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.role in roles;
    }

    function isValidUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    function isPublishedArtwork(slotId, variant, fileName) {
      let configPath = /databases/(default)/documents/publicArtworkConfig/$(slotId);
      return firestore.exists(configPath)
        && firestore.get(configPath).data.variants is map
        && firestore.get(configPath).data.variants[variant] is map
        && 'storagePath' in firestore.get(configPath).data.variants[variant]
        && firestore.get(configPath).data.variants[variant].storagePath is string
        && firestore.get(configPath).data.variants[variant].storagePath
          == 'public-assets/artworks/' + slotId + '/' + variant + '/' + fileName;
    }

    function isHistoricallyPublishedArtwork(slotId, variant, fileName) {
      let publicationId = slotId + '__' + variant + '__' + fileName;
      return firestore.exists(/databases/(default)/documents/publishedArtworkFiles/$(publicationId));
    }

    match /customerUploads/{uid}/{allPaths=**} {
      allow read: if (signedIn() && request.auth.uid == uid) || hasRole(['admin']);
      allow create, update: if signedIn() && request.auth.uid == uid && isValidUpload();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Legacy paths remain available only to the principal administrator.
    match /customers/{allPaths=**} {
      allow read, write: if hasRole(['admin']);
    }

    match /rentals/{allPaths=**} {
      allow read: if hasRole(['admin', 'manager', 'viewer']);
      allow create, update: if hasRole(['admin', 'manager']) && isValidUpload();
      allow delete: if hasRole(['admin', 'manager']);
    }

    match /serviceOrders/{store}/{allPaths=**} {
      allow read, write: if hasRole(['admin', 'manager', 'mechanic'])
        && (hasRole(['admin'])
          || firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.store == 'all'
          || store == firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.store);
    }

    // Payment QR uploads are intentionally public because renters need them at checkout.
    match /settings/{fileName} {
      allow read: if true;
      allow create, update: if hasRole(['admin']) && isValidUpload();
      allow delete: if hasRole(['admin']);
    }

    // Keep the legacy root-level assets unchanged.
    match /public-assets/{fileName} {
      allow read: if true;
      allow create, update: if hasRole(['admin']) && isValidUpload();
      allow delete: if hasRole(['admin']);
    }

    // General public assets remain readable/writable by Admin, except artwork
    // paths which use the publication-aware rule below. Storage grants are OR-combined.
    match /public-assets/{category}/{allPaths=**} {
      allow read: if category != 'artworks';
      allow create, update: if category != 'artworks' && hasRole(['admin']) && isValidUpload();
      allow delete: if category != 'artworks' && hasRole(['admin']);
    }

    match /public-assets/artworks/{slotId}/{variant}/{fileName} {
      allow read: if hasRole(['admin']) || isPublishedArtwork(slotId, variant, fileName);
      allow create: if hasRole(['admin'])
        && resource == null
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp']
        && slotId.matches('[a-z0-9_]+')
        && variant in ['esDesktop', 'esMobile', 'enDesktop', 'enMobile']
        && fileName.matches('[A-Za-z0-9_-]+\\.(png|jpg|webp)');
      allow update: if false;
      // Unpublished drafts can be discarded. An immutable Firestore marker
      // protects every version that has ever been published, even after restore.
      allow delete: if hasRole(['admin'])
        && !isPublishedArtwork(slotId, variant, fileName)
        && !isHistoricallyPublishedArtwork(slotId, variant, fileName);
    }

    // Drafts are private to the Admin who uploaded them. Public readers cannot
    // discover or fetch unapproved artwork.
    match /artwork-drafts/{uid}/{slotId}/{variant}/{fileName} {
      allow read, delete: if hasRole(['admin']) && request.auth.uid == uid;
      allow create: if hasRole(['admin']) && request.auth.uid == uid
        && resource == null
          && request.resource.size > 0
          && request.resource.size <= 8 * 1024 * 1024
          && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp']
          && slotId.matches('[a-z0-9_]+')
          && variant in ['esDesktop', 'esMobile', 'enDesktop', 'enMobile']
          && fileName.matches('[A-Za-z0-9_-]+\\.(png|jpg|webp)');
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
