rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.role in roles;
    }

    function isValidUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    match /customerUploads/{uid}/{allPaths=**} {
      allow read: if (signedIn() && request.auth.uid == uid) || hasRole(['admin']);
      allow create, update: if signedIn() && request.auth.uid == uid && isValidUpload();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Legacy paths remain available only to the principal administrator.
    match /customers/{allPaths=**} {
      allow read, write: if hasRole(['admin']);
    }

    match /rentals/{allPaths=**} {
      allow read: if hasRole(['admin', 'manager', 'viewer']);
      allow create, update: if hasRole(['admin', 'manager']) && isValidUpload();
      allow delete: if hasRole(['admin', 'manager']);
    }

    match /serviceOrders/{store}/{allPaths=**} {
      allow read, write: if hasRole(['admin', 'manager', 'mechanic'])
        && (hasRole(['admin'])
          || firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.store == 'all'
          || store == firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.store);
    }

    // Payment QR uploads are intentionally public because renters need them at checkout.
    match /settings/{fileName} {
      allow read: if true;
      allow create, update: if hasRole(['admin']) && isValidUpload();
      allow delete: if hasRole(['admin']);
    }

    match /public-assets/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasRole(['admin']) && isValidUpload();
      allow delete: if hasRole(['admin']);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
